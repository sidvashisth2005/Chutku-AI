# Copy to .env, or run `.venv\Scripts\python.exe -m chutku.cli setup` and it is written for you.
# Your assistant's name and personality (chosen once at install; change any time with `chutku.cli setup`).
ASSISTANT_NAME=Chutku
ASSISTANT_GENDER=female        # female | male | neutral
ASSISTANT_LANGUAGE=hinglish    # hinglish | english | hindi
# Replies Chutku speaks in her own local voice (same = as above; english if the local Hindi voice sounds off)
ASSISTANT_LOCAL_LANGUAGE=same
ASSISTANT_STYLE=warm           # warm | professional | witty | calm
# The account relay your phone app also reaches (see docs/RELAY.md). Leave empty to skip the phone app.
CHUTKU_RELAY_URL=
# Your account ID (the password is never stored here; the device stays signed in until you log out).
CHUTKU_ACCOUNT_ID=
