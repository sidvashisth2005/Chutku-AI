{
  "app": "whatsapp",
  "name": "WhatsApp",
  "aliases": ["whatsapp", "whats app", "wa"],
  "window": {"exe": "WhatsApp.Root.exe"},
  "launch": {"start_menu": "WhatsApp"},
  "uri_schemes": ["whatsapp"],
  "sources": ["docs/apps/whatsapp.md"],
  "note": "Sending, reading and opening chats stay with message.send / message.read_chat / message.open_chat (they check the chat header). Nothing here opens a chat, so no message is marked read by an atlas action.",
  "actions": [
    {"id": "open", "done": "WhatsApp khol diya.", "title": "Open WhatsApp", "risk": "safe", "route": false,
     "phrases": ["open whatsapp", "whatsapp kholo"],
     "steps": [{"focus": true}], "check": {"window_open": true}},
    {"id": "search", "done": "WhatsApp search khol diya.", "title": "Open WhatsApp chat search", "risk": "safe",
     "phrases": ["whatsapp search kholo", "open whatsapp search", "whatsapp mein search karo"],
     "steps": [{"focus": true}, {"keys": "escape", "wait": 0.5}, {"keys": "ctrl+alt+/", "wait": 1.2}],
     "check": {"ocr_contains": "Recent searches"}, "lab": {"setup": "close_panel"}},
    {"id": "new_chat", "done": "New chat khol diya.", "title": "Open the New chat panel", "risk": "safe",
     "phrases": ["whatsapp new chat", "whatsapp pe new chat kholo", "whatsapp naya chat kholo"],
     "steps": [{"focus": true}, {"keys": "ctrl+alt+n", "wait": 1.2}], "check": {"ocr_contains": "New chat"},
     "lab": {"setup": "close_panel"}},
    {"id": "profile", "done": "Aapki WhatsApp profile khol di.", "title": "Show my WhatsApp profile", "risk": "safe",
     "phrases": ["whatsapp profile kholo", "meri whatsapp profile dikhao", "show my whatsapp profile"],
     "steps": [{"focus": true}, {"keys": "ctrl+alt+p", "wait": 1.2}], "check": {"ocr_contains": "Profile"},
     "lab": {"setup": "close_panel"}},
    {"id": "close_panel", "done": "Band kar diya.", "title": "Close the open WhatsApp panel or search", "risk": "safe",
     "phrases": ["whatsapp panel band karo", "close whatsapp search"],
     "steps": [{"focus": true}, {"keys": "escape", "wait": 0.8}], "check": {"ocr_contains": "Chats"}},
    {"id": "show_unread", "done": "Unread chats dikha diye.", "title": "Show only unread chats", "risk": "safe",
     "phrases": ["whatsapp unread dikhao", "whatsapp pe unread chats dikhao", "show unread chats on whatsapp"],
     "steps": [{"focus": true}, {"keys": "escape", "wait": 0.5},
               {"click_text": "Unread", "area": [0, 0.1, 0.35, 0.3]}],
     "check": {"ocr_contains": "Unread"}, "lab": {"setup": "show_all"}},
    {"id": "show_favourites", "done": "Favourites dikha diye.", "title": "Show favourite chats", "risk": "safe",
     "phrases": ["whatsapp favourites dikhao", "show whatsapp favourites"],
     "steps": [{"focus": true}, {"keys": "escape", "wait": 0.5},
               {"click_text": "Favourites", "area": [0, 0.1, 0.35, 0.3]}],
     "check": {"ocr_contains": "Favourites"}, "lab": {"setup": "show_all"}},
    {"id": "show_all", "done": "Saare chats dikha diye.", "title": "Show all chats", "risk": "safe",
     "phrases": ["whatsapp saare chats dikhao", "show all whatsapp chats"],
     "steps": [{"focus": true}, {"keys": "escape", "wait": 0.5},
               {"click_text": "All", "area": [0, 0.1, 0.35, 0.3]}],
     "check": {"ocr_contains": "Chats"}}
  ]
}
