    "notepad line pe jao"
   ],
   "steps": [
    {
     "focus": true
    },
    {
     "keys": "ctrl+g",
     "wait": 0.6
    }
   ],
   "check": {
    "window_open": true
   },
   "done": "Go to line khol diya."
  }
 ]
}