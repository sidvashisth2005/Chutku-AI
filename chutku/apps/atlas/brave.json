{
  "app": "brave",
  "name": "Brave",
  "aliases": ["brave", "browser", "youtube"],
  "window": {"exe": "brave.exe"},
  "launch": {"start_menu": "Brave"},
  "uri_schemes": [],
  "sources": ["docs/apps/brave.md"],
  "note": "Opening sites and searching stay with web.open / web.search / youtube.play. YouTube keys are sent only when the Brave window's title says YouTube. Clean-up actions close only the tab whose title they name.",
  "actions": [
    {"id": "open", "done": "Brave khol diya.", "title": "Open Brave", "risk": "safe", "route": false,
     "phrases": ["open brave", "brave kholo"], "steps": [{"focus": true}], "check": {"window_open": true}},
    {"id": "new_tab", "done": "Naya tab khol diya.", "title": "Open a new tab", "risk": "safe",
     "phrases": ["brave new tab", "brave mein naya tab kholo", "open a new tab in brave"],
     "steps": [{"focus": true}, {"keys": "ctrl+t", "wait": 1}], "check": {"window_title_contains": "New Tab"},
     "lab": {"after": "close_new_tab"}},
    {"id": "history", "done": "History khol di.", "title": "Show browser history", "risk": "safe",
     "phrases": ["brave history kholo", "browser history dikhao", "show brave history"],
     "steps": [{"focus": true}, {"keys": "ctrl+h", "wait": 1.2}], "check": {"window_title_contains": "History"},
     "lab": {"after": "close_history"}},
    {"id": "downloads", "done": "Downloads khol diye.", "title": "Show the downloads page", "risk": "safe",
     "phrases": ["brave downloads kholo", "browser downloads dikhao", "show brave downloads"],
     "steps": [{"focus": true}, {"keys": "ctrl+j", "wait": 1.2}], "check": {"window_title_contains": "Downloads"},
     "lab": {"after": "close_downloads"}},
    {"id": "bookmarks", "done": "Bookmarks khol diye.", "title": "Show bookmarks", "risk": "safe",
     "phrases": ["brave bookmarks kholo", "bookmarks dikhao", "show brave bookmarks"],
     "steps": [{"focus": true}, {"keys": "ctrl+shift+o", "wait": 1.2}], "check": {"window_title_contains": "Bookmarks"},
     "lab": {"after": "close_bookmarks"}},
    {"id": "close_new_tab", "title": "Close the tab if it is an empty New Tab", "risk": "safe", "route": false,
     "steps": [{"focus": true}, {"keys": "ctrl+w", "wait": 0.8, "if_title": "New Tab - Brave"}],
     "check": {"title_lacks": "New Tab - Brave"}, "lab": {"skip": "clean-up helper"}},
    {"id": "close_history", "title": "Close the tab if it is History", "risk": "safe", "route": false,
     "steps": [{"focus": true}, {"keys": "ctrl+w", "wait": 0.8, "if_title": "History - Brave"}],
     "check": {"title_lacks": "History - Brave"}, "lab": {"skip": "clean-up helper"}},
    {"id": "close_downloads", "title": "Close the tab if it is Downloads", "risk": "safe", "route": false,
     "steps": [{"focus": true}, {"keys": "ctrl+w", "wait": 0.8, "if_title": "Downloads - Brave"}],
     "check": {"title_lacks": "Downloads - Brave"}, "lab": {"skip": "clean-up helper"}},
    {"id": "close_bookmarks", "title": "Close the tab if it is Bookmarks", "risk": "safe", "route": false,
     "steps": [{"focus": true}, {"keys": "ctrl+w", "wait": 0.8, "if_title": "Bookmarks - Brave"}],
     "check": {"title_lacks": "Bookmarks - Brave"}, "lab": {"skip": "clean-up helper"}},
    {"id": "close_tab", "done": "Tab band kar diya.", "title": "Close the current tab", "risk": "changes",
     "phrases": ["brave tab band karo", "close this tab", "ye tab band karo"],
     "steps": [{"focus": true}, {"keys": "ctrl+w", "wait": 0.8}], "check": {"window_open": true},
     "note": "reopen_closed_tab undoes it"},
    {"id": "reopen_closed_tab", "done": "Band kiya hua tab wapas khol diya.", "title": "Reopen the last closed tab",
     "risk": "safe", "phrases": ["band kiya hua tab wapas kholo", "reopen closed tab", "brave last tab wapas lao"],
     "steps": [{"focus": true}, {"keys": "ctrl+shift+t", "wait": 1.2}], "check": {"window_open": true},
     "lab": {"skip": "would reopen whatever the owner closed last"}},
    {"id": "reload", "done": "Page reload kar diya.", "title": "Reload the page", "risk": "safe",
     "phrases": ["brave reload karo", "page reload karo", "refresh the page"],
     "steps": [{"focus": true}, {"keys": "f5", "wait": 1}], "check": {"window_open": true},
     "lab": {"skip": "reloading could lose what the owner typed in a form"}},
    {"id": "zoom_in", "done": "Page bada kar diya.", "title": "Zoom in", "risk": "safe",
     "phrases": ["brave zoom in", "page bada karo", "zoom in in brave"],
     "steps": [{"focus": true}, {"keys": "ctrl+=", "wait": 0.5}], "lab": {"after": "zoom_reset"}},
    {"id": "zoom_out", "done": "Page chhota kar diya.", "title": "Zoom out", "risk": "safe",
     "phrases": ["brave zoom out", "page chhota karo", "zoom out in brave"],
     "steps": [{"focus": true}, {"keys": "ctrl+minus", "wait": 0.5}], "lab": {"after": "zoom_reset"}},
    {"id": "zoom_reset", "done": "Zoom normal kar diya.", "title": "Reset zoom", "risk": "safe",
     "phrases": ["brave zoom normal karo", "reset zoom", "page normal size karo"],
     "steps": [{"focus": true}, {"keys": "ctrl+0", "wait": 0.5}]},
    {"id": "yt_forward", "done": "Video 10 second aage kar diya.", "title": "YouTube: skip 10 seconds ahead",
     "risk": "safe", "phrases": ["youtube 10 second aage karo", "video aage karo", "skip 10 seconds on youtube"],
     "steps": [{"focus": true}, {"keys": "l", "require_title": "YouTube"}]},
    {"id": "yt_back", "done": "Video 10 second peeche kar diya.", "title": "YouTube: go back 10 seconds",
     "risk": "safe", "phrases": ["youtube 10 second peeche karo", "video peeche karo", "go back 10 seconds on youtube"],
     "steps": [{"focus": true}, {"keys": "j", "require_title": "YouTube"}]},
    {"id": "yt_captions", "done": "Captions badal diye.", "title": "YouTube: captions on/off", "risk": "safe",
     "phrases": ["youtube captions on karo", "subtitles on karo", "youtube subtitles band karo", "captions on off"],
     "steps": [{"focus": true}, {"keys": "c", "require_title": "YouTube"}], "lab": {"pair": true}},
    {"id": "yt_theatre", "done": "Theatre mode badal diya.", "title": "YouTube: theatre mode on/off", "risk": "safe",
     "phrases": ["youtube theatre mode", "theatre mode on karo"],
     "steps": [{"focus": true}, {"keys": "t", "require_title": "YouTube"}], "lab": {"pair": true}},
    {"id": "yt_fullscreen", "done": "Fullscreen badal diya.", "title": "YouTube: full screen on/off", "risk": "safe",
     "phrases": ["youtube full screen karo", "video full screen karo", "full screen band karo"],
     "steps": [{"focus": true}, {"keys": "f", "require_title": "YouTube", "wait": 1}], "lab": {"pair": true}},
    {"id": "yt_faster", "done": "Speed badha di.", "title": "YouTube: play faster", "risk": "safe",
     "phrases": ["youtube speed badhao", "video fast karo", "speed up the video"],
     "steps": [{"focus": true}, {"keys": "shift+.", "require_title": "YouTube"}], "lab": {"after": "yt_slower"}},
    {"id": "yt_slower", "done": "Speed kam kar di.", "title": "YouTube: play slower", "risk": "safe",
     "phrases": ["youtube speed kam karo", "video slow karo", "slow down the video"],
     "steps": [{"focus": true}, {"keys": "shift+,", "require_title": "YouTube"}], "lab": {"after": "yt_faster"}},
    {"id": "yt_next", "done": "Agla video laga diya.", "title": "YouTube: next video", "risk": "safe",
     "phrases": ["youtube next video", "agla video chalao", "next video on youtube"],
     "steps": [{"focus": true}, {"keys": "shift+n", "require_title": "YouTube", "wait": 2}],
     "lab": {"skip": "would change what the owner is watching"}}
  ]
}
