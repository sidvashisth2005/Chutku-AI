{
  "app": "spotify",
  "name": "Spotify",
  "aliases": ["spotify", "gaane", "gaana", "music", "songs"],
  "window": {"exe": "Spotify.exe"},
  "launch": {"start_menu": "Spotify"},
  "uri_schemes": ["spotify"],
  "sources": ["https://support.spotify.com/us/article/keyboard-shortcuts/",
              "https://developer.spotify.com/documentation/web-api/concepts/spotify-uris-ids"],
  "actions": [
    {"id": "open", "title": "Open Spotify", "risk": "safe",
     "phrases": ["open spotify", "spotify kholo"],
     "steps": [{"focus": true}], "check": {"window_open": true}},
    {"id": "pause", "title": "Pause the music", "risk": "safe",
     "phrases": ["pause spotify", "spotify pause karo", "gaana roko"],
     "steps": [{"media": "pause"}], "check": {"media_paused": true}},
    {"id": "resume", "title": "Resume the music", "risk": "safe",
     "phrases": ["resume spotify", "spotify chalao", "gaana wapas chalao"],
     "steps": [{"media": "play"}], "check": {"media_playing": true}},
    {"id": "next", "title": "Next song", "risk": "safe",
     "phrases": ["next song on spotify", "agla gaana"],
     "steps": [{"media": "next"}, {"sleep": 1}], "check": {"media_changed": true}},
    {"id": "previous", "title": "Previous song", "risk": "safe",
     "phrases": ["previous song on spotify", "pichhla gaana"],
     "steps": [{"media": "previous"}, {"sleep": 0.3}, {"media": "previous"}, {"sleep": 1}],
     "check": {"media_changed": true}, "lab": {"setup": "next"},
     "note": "one press only restarts a song that is past 3 s"},
    {"id": "shuffle", "title": "Turn shuffle on or off", "risk": "safe",
     "phrases": ["spotify shuffle", "shuffle on karo"],
     "steps": [{"focus": true}, {"keys": "ctrl+s"}], "lab": {"pair": true}},
    {"id": "repeat", "title": "Cycle repeat mode", "risk": "safe",
     "phrases": ["spotify repeat", "repeat on karo"],
     "steps": [{"focus": true}, {"keys": "ctrl+r"}], "lab": {"pair": 2}},
    {"id": "volume_up", "title": "Spotify volume up", "risk": "safe",
     "phrases": ["spotify volume up", "spotify ki awaaz badhao"],
     "steps": [{"focus": true}, {"keys": "ctrl+up"}]},
    {"id": "volume_down", "title": "Spotify volume down", "risk": "safe",
     "phrases": ["spotify volume down", "spotify ki awaaz kam karo"],
     "steps": [{"focus": true}, {"keys": "ctrl+down"}]},
    {"id": "search", "title": "Search Spotify", "risk": "safe",
     "params": {"query": {"type": "text"}},
     "phrases": ["search {query} on spotify", "spotify pe {query} search karo", "spotify mein {query} dhoondo"],
     "steps": [{"uri": "spotify:search:{query}"}, {"sleep": 2}], "check": {"window_open": true},
     "drill": {"query": "lofi beats"}},
    {"id": "go_home", "title": "Go to Spotify Home", "risk": "safe",
     "phrases": ["spotify home", "spotify home kholo"],
     "steps": [{"focus": true}, {"keys": "alt+shift+h", "wait": 1.5}], "check": {"ocr_contains": "Show all"}},
    {"id": "go_playlists", "title": "Show my playlists", "risk": "safe",
     "phrases": ["show my playlists", "meri playlists dikhao", "spotify playlists kholo"],
     "steps": [{"focus": true}, {"keys": "alt+shift+0", "wait": 1.5}], "check": {"ocr_contains": "Your Library"}},
    {"id": "go_liked", "title": "Show Liked Songs", "risk": "safe",
     "phrases": ["show liked songs", "liked songs kholo"],
     "steps": [{"focus": true}, {"keys": "alt+shift+s", "wait": 1.5}], "check": {"ocr_contains": "Liked Songs"}},
    {"id": "go_queue", "title": "Show the queue", "risk": "safe",
     "phrases": ["show spotify queue", "spotify queue dikhao"],
     "steps": [{"focus": true}, {"keys": "alt+shift+q", "wait": 1.5, "unless": "Queue"}], "check": {"ocr_contains": "Queue"},
     "note": "Alt+Shift+Q toggles the panel, so it is pressed only when the queue is not showing"},
    {"id": "play_playlist", "title": "Play one of my playlists by its exact name", "risk": "safe",
     "params": {"name": {"type": "text"}},
     "phrases": ["play {name} playlist", "play my {name} playlist", "{name} playlist chalao", "{name} playlist bajao",
                 "{name} wali playlist chalao", "{name} playlist play karo"],
     "steps": [{"focus": true}, {"keys": "alt+shift+0", "wait": 1.5},
               {"click_text": "{name}", "kind": "playlist", "double": true}, {"sleep": 1.5}],
     "check": {"playing_on_page": true}, "drill": {"name": "After Party"},
     "note": "double-clicking a row of Your Library plays it; the check reads the opened page for the song"},
    {"id": "play_liked", "title": "Play my Liked Songs", "risk": "safe",
     "phrases": ["play liked songs", "liked songs chalao", "meri liked songs bajao"],
     "steps": [{"focus": true}, {"keys": "alt+shift+0", "wait": 1.5},
               {"click_text": "Liked Songs", "kind": "playlist", "double": true}, {"sleep": 1.5}],
     "check": {"playing_on_page": true}},
    {"id": "new_playlist", "title": "Create a new empty playlist", "risk": "changes",
     "phrases": ["create a new spotify playlist", "nayi playlist banao"],
     "steps": [{"focus": true}, {"keys": "ctrl+n", "wait": 1.5}], "check": {"ocr_contains": "My Playlist"}},
    {"id": "quit", "title": "Quit Spotify", "risk": "safe",
     "phrases": ["quit spotify", "spotify band karo"],
     "steps": [{"focus": true}, {"keys": "ctrl+shift+q", "wait": 1}], "check": {"process_gone": true},
     "lab": {"skip": "quitting Spotify mid-lab would stop the owner's music"}}
  ]
}
